# ==============================================================================
# AI Employee Platform — Production Environment Configuration Template
# File: .env.prod.example
#
# INSTRUCTIONS:
# 1. Copy this file to .env.prod:
#    cp .env.prod.example .env.prod
# 2. Generate secure random values for passwords and encryption keys:
#    - On Linux/macOS: openssl rand -hex 32
#    - On Windows PowerShell: python -c "import secrets; print(secrets.token_hex(32))"
# 3. Fill in your registered public domains (or local test hostnames).
# 4. Never commit .env.prod to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Hostnames & Edge Gateway (Caddy)
# ------------------------------------------------------------------------------
# For production: set to your registered FQDNs (e.g. admin.yourcompany.com)
# For local Windows testing: set to http://admin.local or configure tls internal
ADMIN_DOMAIN=admin.example.com
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com

# ACME Registration Email (used by Let's Encrypt / ZeroSSL for cert notices)
CADDY_ACME_EMAIL=admin@example.com

# Caddy HTTPS Mode (set to "on" for production, or "off" for plain HTTP local testing)
CADDY_AUTO_HTTPS=on

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL 17 + pgvector)
# ------------------------------------------------------------------------------
POSTGRES_DB=ai_employee_prod
POSTGRES_USER=ai_employee_admin
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=replace_with_strong_random_db_password_min24chars

# ------------------------------------------------------------------------------
# 3. Redis Cache & Distributed Locks
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 24
REDIS_PASSWORD=replace_with_strong_random_redis_password_min24chars

# ------------------------------------------------------------------------------
# 4. Core Security, JWT & Encryption Keys
# ------------------------------------------------------------------------------
# Platform Environment (must be "production" to enforce strict security guards)
ENVIRONMENT=production

# JWT Secret Key (CRITICAL: must be at least 32 characters, never start with "dev-")
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_cryptographically_secure_random_key_min32chars

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_ISSUER=ai-employee-platform
JWT_AUDIENCE=ai-employee-api
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# AES-256-GCM Secrets Encryption Key (CRITICAL: must be exactly 32-bytes / 64-char hex)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRETS_ENCRYPTION_KEY=replace_with_64_character_hex_string_for_aes256_encryption_key

# ------------------------------------------------------------------------------
# 5. AI Providers Configuration
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=your_production_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Optional alternative providers
GROQ_API_KEY=
OPENAI_API_KEY=
AI_PLANNING_ENABLED=false

# ------------------------------------------------------------------------------
# 6. Background Outbox Worker Tuning
# ------------------------------------------------------------------------------
OUTBOX_WORKER_POLL_INTERVAL=1.0
OUTBOX_WORKER_BATCH_SIZE=10
OUTBOX_WORKER_LOCK_TIMEOUT=300

# ------------------------------------------------------------------------------
# 7. Rate Limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_PLANNING_PER_MINUTE=30
